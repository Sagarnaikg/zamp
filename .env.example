# Copy this file to .env and fill in the values below.
#   cp .env.example .env

# Required. Any Postgres connection string. This matches docker-compose.yml,
# so `docker compose up -d` gives you a working database with no changes.
DATABASE_URL=postgres://zamp:zamp@localhost:5432/zamp_dev

# Required: at least ONE LLM provider key. On startup the app asks each
# configured provider which models your account can actually use, so there
# are no model IDs to pin or keep up to date here.
#
# A second provider strengthens the confidence engine's agreement signal:
# two providers read each document independently, instead of one provider
# reading it two different ways.
GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional. Vercel Blob storage for uploaded documents. When unset, files
# are stored on local disk under ./uploads — the default for local dev.
# BLOB_READ_WRITE_TOKEN=

# Optional. Client-side config — see src/config/env.ts. Safe to leave unset
# for local development.
# NEXT_PUBLIC_API_BASE_URL=
# NEXT_PUBLIC_ERROR_REPORTING_URL=
