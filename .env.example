# --- Required ---

# Any Postgres connection string works. For one-command local Postgres:
#   docker compose up -d
DATABASE_URL=postgres://zamp:zamp@localhost:5432/zamp_dev

# At least ONE of the following LLM provider keys is required.
# With multiple keys, cross-provider routing and the cross-model
# agreement confidence signal activate automatically.
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Optional ---

# Vercel Blob file storage. When unset, uploaded files are stored in ./uploads
# on local disk — fine for local runs and self-hosting.
# BLOB_READ_WRITE_TOKEN=
